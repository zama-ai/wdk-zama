{
  "name": "@zama-fhe/wdk-wallet-evm-zama",
  "version": "0.1.0-alpha.0",
  "description": "WDK community module adding Zama confidential tokens (cUSDT) to EVM wallet accounts: decrypted balances, confidential transfers, shield and unshield.",
  "keywords": [
    "wdk",
    "wallet",
    "evm",
    "ethereum",
    "zama",
    "fhe",
    "confidential",
    "erc-7984",
    "cusdt"
  ],
  "author": "Zama <hello@zama.ai>",
  "license": "BSD-3-Clause-Clear",
  "homepage": "https://docs.zama.org/protocol",
  "repository": {
    "type": "git",
    "url": "https://github.com/zama-ai/wdk-zama.git",
    "directory": "packages/wallet-evm-zama"
  },
  "main": "index.js",
  "type": "module",
  "types": "./types",
  "files": [
    "index.js",
    "bare.js",
    "src",
    "types",
    "examples"
  ],
  "scripts": {
    "build:types": "tsc",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --testPathIgnorePatterns=/tests/integration/",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage --testPathIgnorePatterns=/tests/integration/",
    "test:integration": "cross-env NODE_OPTIONS=--experimental-vm-modules jest tests/integration --runInBand --forceExit"
  },
  "dependencies": {
    "@tetherto/wdk-wallet": "1.0.0-beta.25",
    "@tetherto/wdk-wallet-evm": "1.0.0-beta.25",
    "@zama-fhe/sdk": "3.7.0",
    "bare-node-runtime": "1.5.4",
    "ethers": "6.17.0",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "cross-env": "7.0.3",
    "jest": "29.7.0",
    "standard": "17.1.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "bare": "./bare.js",
      "default": "./index.js"
    },
    "./adapter": {
      "types": "./types/src/adapter/index.d.ts",
      "default": "./src/adapter/index.js"
    },
    "./package": {
      "default": "./package.json"
    }
  },
  "standard": {
    "env": [
      "jest"
    ],
    "ignore": [
      "bare.js",
      "tests/**/*.js"
    ]
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {}
  }
}
