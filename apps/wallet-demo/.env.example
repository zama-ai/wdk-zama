# Copy to .env.local (git-ignored) and fill in what you need. Restart `npm run demo` after a change.

# Sepolia RPC. Defaults to a public endpoint.
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# Recovery phrase to open on load, so you skip onboarding. Testnet wallets only.
# Read by `npm run demo` (next dev) only; production builds ignore it.
NEXT_PUBLIC_DEMO_SEED_PHRASE=
