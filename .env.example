# Copy to .env (gitignored). Node loads it through --env-file-if-exists in the npm scripts.

# One of the two. A seed phrase gives the examples a second account to use as recipient.
SEPOLIA_SEED=
SEPOLIA_PRIVATE_KEY=

# Optional. Defaults to a public Sepolia endpoint.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional. The Sepolia relayer currently needs no key; mainnet does.
ZAMA_RELAYER_API_KEY=

# Optional. Recipient of the confidential transfer in the wallet example.
# Defaults to account #1 of the seed; required when using SEPOLIA_PRIVATE_KEY (also for test:integration).
RECIPIENT=
